PORT=3000
NODE_ENV=production
# GitHub Pages origin, for example: https://yourname.github.io
KX_FRONTEND_ORIGIN=
# Public HTTPS API URL used by the static frontend
KX_API_BASE_URL=
KX_SESSION_SECRET=replace-with-a-long-random-secret
KX_OWNER_EMAIL=owner@example.com
KX_OWNER_PASSWORD=replace-with-a-strong-password
KX_DEVELOPER_EMAIL=developer@example.com
KX_DEVELOPER_PASSWORD=replace-with-a-different-strong-password
# Optional: Discord webhook that announces new demos. Set it on the server host only.
DISCORD_WEBHOOK_URL=
# Optional display names for the two seeded accounts (defaults: Label Owner / Developer)
KX_OWNER_NAME=
KX_DEVELOPER_NAME=
# Neon Postgres connection string (copy the pooled one from the Neon dashboard). Required.
# Looks like: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
